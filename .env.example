# [TEMPLATE]
# Secret lokal, jangan commit file .env. Jangan kirim key ke chat atau log.
# OPENAI_API_KEY adalah nama kompatibilitas untuk semua provider.
OPENAI_API_KEY=isi-api-key-provider-di-sini

# Pilihan: openai, google, openrouter, groq, atau custom.
# Default: openai
DN_PROVIDER=openai

# Model harus tersedia pada provider terpilih dan mendukung gambar serta tools.
OPENAI_MODEL=isi-model-provider-di-sini

# Opsional. Wajib jika DN_PROVIDER=custom. OPENAI_BASE_URL lama tetap dibaca.
# DN_BASE_URL=https://example.invalid/v1
# OPENAI_BASE_URL=https://example.invalid/v1

# Wajib di Windows agar input hanya dikirim saat jendela game aktif.
DN_WINDOW_TITLE=Dragon Nest

# Opsional untuk profil Minotaur. Jika unset, kedua label legacy diizinkan.
# Nilai: stage_entrance atau town. Flag CLI menang atas nilai ini.
# DN_RETREAT_DESTINATION=stage_entrance

# Opsional: tujuan sesi, capture region, monitor, dan timeout.
# DN_INSTRUCTION=Amati screenshot dan dekati NPC terdekat
# DN_CAPTURE_LEFT=0
# DN_CAPTURE_TOP=0
# DN_CAPTURE_WIDTH=1024
# DN_CAPTURE_HEIGHT=768
# DN_MONITOR=1
# OPENAI_TIMEOUT=60

# Contoh Google AI Studio Gemini:
# DN_PROVIDER=google
# OPENAI_API_KEY=isi-key-Google-AI-Studio-di-sini
# OPENAI_MODEL=gemini-2.5-flash

# Contoh OpenAI:
# DN_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-isi-key-di-sini
# OPENAI_MODEL=gpt-4o

# Contoh OpenRouter:
# DN_PROVIDER=openrouter
# OPENAI_API_KEY=isi-key-OpenRouter-di-sini
# OPENAI_MODEL=provider/model-yang-mendukung-vision-tools

# Contoh Groq:
# DN_PROVIDER=groq
# OPENAI_API_KEY=gsk_isi-key-Groq-di-sini
# OPENAI_MODEL=model-vision-yang-mendukung-tools
