# Secret lokal, jangan commit file .env
# Preflight menolak placeholder ini, isi API key OpenAI asli.
OPENAI_API_KEY=sk-your-openai-key-here
# Pilih model OpenAI yang mendukung vision dan tool calling.
OPENAI_MODEL=isi-model-openai-yang-mendukung-vision-dan-tools

# Wajib di Windows agar input hanya dikirim saat jendela game aktif.
DN_WINDOW_TITLE=Dragon Nest

# Opsional untuk profil Minotaur, pilih satu tujuan retreat.
# Nilai: stage_entrance atau town. Jika variabel tidak diatur, kedua label legacy diizinkan.
# Flag CLI --retreat-destination menang atas nilai ini.
# DN_RETREAT_DESTINATION=stage_entrance

# Opsional: tujuan sesi (default teks bawaan; flag CLI --instruction menang atas ini).
# DN_INSTRUCTION=Amati screenshot dan dekati NPC terdekat
# Opsional: capture region game dalam koordinat monitor fisik
# DN_CAPTURE_LEFT=0
# DN_CAPTURE_TOP=0
# DN_CAPTURE_WIDTH=1024
# DN_CAPTURE_HEIGHT=768
# Opsional: indeks monitor MSS (1 = monitor pertama)
# DN_MONITOR=1
# Opsional: timeout request OpenAI dalam detik (default 60; bilangan bulat positif).
# Request yang hang dibatasi dan dicoba ulang sebagai error jaringan.
# OPENAI_TIMEOUT=60
